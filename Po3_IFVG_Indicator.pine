// Po3 + IFVG | ICT Strategy — Pine Script v6
// Power of 3 (Accumulation > Manipulation > Distribution) + Implied & Inversion FVG
// Backtestable strategy — signals also fire on live bars for real-time alerts.

//@version=6
strategy("Po3 + IFVG | ICT", shorttitle="Po3+IFVG", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     commission_type=strategy.commission.percent,
     commission_value=0.07,
     slippage=2,
     process_orders_on_close=true,
     max_boxes_count=100,
     max_labels_count=50)

// ============================================================================
// INPUTS
// ============================================================================

atrPer  = input.int(14,   "ATR Period",            group="Risk")
slBuf   = input.float(0.5,"SL Buffer (x ATR)",     group="Risk", minval=0.0, step=0.1)
rrTP    = input.float(2.0, "Risk:Reward Ratio",     group="Risk", minval=1.0, step=0.5)

showFVG      = input.bool(true,  "Show FVG Zones",              group="Display")
showIFVG     = input.bool(true,  "Show Implied FVG (IFVG)",     group="Display")
showInvFVG   = input.bool(true,  "Show Inversion FVG",          group="Display")
showAsian    = input.bool(true,  "Show Asian Range Box",        group="Display")
showLondon   = input.bool(false, "Show London Box",             group="Display")
showNY       = input.bool(false, "Show NY Box",                 group="Display")
fvgMaxAge    = input.int(50,     "FVG Lookback (bars)",         group="Display", minval=10, maxval=300)
fvgOpacity   = input.int(80,     "FVG Zone Opacity",            group="Display", minval=0, maxval=100)
ifvgBodyMult = input.float(1.5,  "IFVG Body Filter",            group="Display", minval=1.0, step=0.1)
invNeedsBody = input.bool(true,  "Inversion Needs Body Close",  group="Display")

asianS  = input.int(0,  "Asian Start (UTC hr)",  group="Sessions", minval=0, maxval=23)
asianE  = input.int(7,  "Asian End   (UTC hr)",  group="Sessions", minval=0, maxval=23)
londonS = input.int(7,  "London Start (UTC hr)", group="Sessions", minval=0, maxval=23)
londonE = input.int(10, "London End   (UTC hr)", group="Sessions", minval=0, maxval=23)
nyS     = input.int(12, "NY Start     (UTC hr)", group="Sessions", minval=0, maxval=23)
nyE     = input.int(20, "NY End       (UTC hr)", group="Sessions", minval=0, maxval=23)

cBull     = input.color(#26a69a, "Bullish FVG",         group="Colors")
cBear     = input.color(#ef5350, "Bearish FVG",         group="Colors")
cIFVGBull = input.color(#fff176, "Implied FVG Bull",    group="Colors")
cIFVGBear = input.color(#ffb74d, "Implied FVG Bear",    group="Colors")
cInvBull  = input.color(#80deea, "Inversion FVG Bull",  group="Colors")
cInvBear  = input.color(#ef9a9a, "Inversion FVG Bear",  group="Colors")
cAsian    = input.color(#1565c0, "Asian Range",         group="Colors")

// ============================================================================
// HELPERS
// ============================================================================

atrVal = ta.atr(atrPer)

inSes(sH, eH) =>
    h = hour(time, "UTC")
    sH < eH ? h >= sH and h < eH : h >= sH or h < eH

isAsian  = inSes(asianS, asianE)
isLondon = inSes(londonS, londonE)
isNY     = inSes(nyS, nyE)
newDay   = ta.change(time("D")) != 0

bSz(n)   => math.abs(close[n] - open[n])
bullC(n) => close[n] > open[n]

// ============================================================================
// PO3 — ACCUMULATION RANGE AND MANIPULATION DETECTION
// ============================================================================

var float aHi   = na
var float aLo   = na
var box   aBx   = na
var box   lBx   = na
var box   nBx   = na
var float swpLo = na
var float swpHi = na
var bool  mBull = false
var bool  mBear = false
var bool  mDone = false
var bool  lfired = false
var bool  sfired = false

if newDay
    aHi    := na
    aLo    := na
    swpLo  := na
    swpHi  := na
    mBull  := false
    mBear  := false
    mDone  := false
    lfired := false
    sfired := false
    aBx    := na
    lBx    := na
    nBx    := na

if isAsian
    aHi := na(aHi) ? high : math.max(aHi, high)
    aLo := na(aLo) ? low  : math.min(aLo, low)
    if showAsian
        if na(aBx)
            aBx := box.new(bar_index, aHi, bar_index, aLo, border_color=color.new(cAsian, 50), bgcolor=color.new(cAsian, 90), border_width=1)
        else
            box.set_right(aBx,   bar_index)
            box.set_top(aBx,     aHi)
            box.set_bottom(aBx,  aLo)

if isLondon and showLondon
    if na(lBx)
        lBx := box.new(bar_index, high, bar_index, low, border_color=color.new(#1b5e20, 50), bgcolor=color.new(#1b5e20, 93))
    else
        box.set_right(lBx,  bar_index)
        box.set_top(lBx,    math.max(box.get_top(lBx), high))
        box.set_bottom(lBx, math.min(box.get_bottom(lBx), low))

if isNY and showNY
    if na(nBx)
        nBx := box.new(bar_index, high, bar_index, low, border_color=color.new(#4a148c, 50), bgcolor=color.new(#4a148c, 93))
    else
        box.set_right(nBx,  bar_index)
        box.set_top(nBx,    math.max(box.get_top(nBx), high))
        box.set_bottom(nBx, math.min(box.get_bottom(nBx), low))

// Detect manipulation sweep during London or NY
if (isLondon or isNY) and not mDone and not na(aHi) and not na(aLo)
    if low < aLo
        mBull := true
        swpLo := low
        mDone := true
    else if high > aHi
        mBear := true
        swpHi := high
        mDone := true

// ============================================================================
// FVG — Detection and lifecycle
// ============================================================================

var float[] BT = array.new_float()
var float[] BB = array.new_float()
var int[]   BI = array.new_int()
var box[]   BX = array.new_box()
var bool[]  BM = array.new_bool()

var float[] ST = array.new_float()
var float[] SB = array.new_float()
var int[]   SI = array.new_int()
var box[]   SX = array.new_box()
var bool[]  SM = array.new_bool()

if high[2] < low[0] and showFVG
    t = low[0]
    b = high[2]
    array.push(BT, t)
    array.push(BB, b)
    array.push(BI, bar_index[2])
    array.push(BX, box.new(bar_index[2], t, bar_index + fvgMaxAge, b, bgcolor=color.new(cBull, fvgOpacity), border_color=color.new(cBull, 50)))
    array.push(BM, false)

if low[2] > high[0] and showFVG
    t = low[2]
    b = high[0]
    array.push(ST, t)
    array.push(SB, b)
    array.push(SI, bar_index[2])
    array.push(SX, box.new(bar_index[2], t, bar_index + fvgMaxAge, b, bgcolor=color.new(cBear, fvgOpacity), border_color=color.new(cBear, 50)))
    array.push(SM, false)

if array.size(BT) > 0
    for i = array.size(BT) - 1 to 0
        zT = array.get(BT, i)
        zB = array.get(BB, i)
        bx = array.get(BX, i)
        if bar_index - array.get(BI, i) > fvgMaxAge
            box.delete(bx)
            array.remove(BT, i)
            array.remove(BB, i)
            array.remove(BI, i)
            array.remove(BX, i)
            array.remove(BM, i)
            continue
        if not array.get(BM, i)
            box.set_right(bx, bar_index + 20)
            violated = invNeedsBody ? close < zB : low < zB
            if violated and showInvFVG
                array.set(BM, i, true)
                box.delete(bx)
                box.new(array.get(BI, i), zT, bar_index + 20, zB, bgcolor=color.new(cInvBear, 70), border_color=color.new(cInvBear, 20), border_width=2)
            else if close < zB
                array.set(BM, i, true)
                box.delete(bx)

if array.size(ST) > 0
    for i = array.size(ST) - 1 to 0
        zT = array.get(ST, i)
        zB = array.get(SB, i)
        bx = array.get(SX, i)
        if bar_index - array.get(SI, i) > fvgMaxAge
            box.delete(bx)
            array.remove(ST, i)
            array.remove(SB, i)
            array.remove(SI, i)
            array.remove(SX, i)
            array.remove(SM, i)
            continue
        if not array.get(SM, i)
            box.set_right(bx, bar_index + 20)
            violated = invNeedsBody ? close > zT : high > zT
            if violated and showInvFVG
                array.set(SM, i, true)
                box.delete(bx)
                box.new(array.get(SI, i), zT, bar_index + 20, zB, bgcolor=color.new(cInvBull, 70), border_color=color.new(cInvBull, 20), border_width=2)
            else if close > zT
                array.set(SM, i, true)
                box.delete(bx)

// ============================================================================
// IMPLIED FVG (IFVG)
// ============================================================================

bIFVG = high[2] >= open[1] and bullC(1) and low[0] <= close[1] and high[2] >= low[0] and bSz(1) >= math.max(bSz(2), bSz(0)) * ifvgBodyMult
sIFVG = low[2] <= open[1] and not bullC(1) and high[0] >= close[1] and low[2] <= high[0] and bSz(1) >= math.max(bSz(2), bSz(0)) * ifvgBodyMult

if bIFVG and showIFVG
    zT = (high[2] + close[2]) / 2
    zB = (low[0]  + open[0])  / 2
    if zT > zB
        box.new(bar_index[2], zT, bar_index + 20, zB, bgcolor=color.new(cIFVGBull, 60), border_color=color.new(cIFVGBull, 10), border_width=2)

if sIFVG and showIFVG
    zT = (high[0] + open[0])  / 2
    zB = (low[2]  + close[2]) / 2
    if zT > zB
        box.new(bar_index[2], zT, bar_index + 20, zB, bgcolor=color.new(cIFVGBear, 60), border_color=color.new(cIFVGBear, 10), border_width=2)

// ============================================================================
// ENTRY SIGNALS
// ============================================================================

inBFZ = false
if array.size(BT) > 0
    for i = array.size(BT) - 1 to 0
        if not array.get(BM, i) and close >= array.get(BB, i) and close <= array.get(BT, i)
            inBFZ := true
            break

inSFZ = false
if array.size(ST) > 0
    for i = array.size(ST) - 1 to 0
        if not array.get(SM, i) and close >= array.get(SB, i) and close <= array.get(ST, i)
            inSFZ := true
            break

lSig = mBull and not lfired and not na(aLo) and close > aLo and (inBFZ or bIFVG)
sSig = mBear and not sfired and not na(aHi) and close < aHi and (inSFZ or sIFVG)

if lSig
    lfired := true
if sSig
    sfired := true

// ============================================================================
// STRATEGY ENTRIES AND EXITS
// ============================================================================

if lSig
    sl_l  = (not na(swpLo) ? swpLo : low) - atrVal * slBuf
    tp_l  = close + math.abs(close - sl_l) * rrTP
    strategy.entry("Long", strategy.long, comment="Po3+IFVG")
    strategy.exit("Long Exit", "Long", stop=sl_l, limit=tp_l, comment="TP/SL")

if sSig
    sl_s  = (not na(swpHi) ? swpHi : high) + atrVal * slBuf
    tp_s  = close - math.abs(sl_s - close) * rrTP
    strategy.entry("Short", strategy.short, comment="Po3+IFVG")
    strategy.exit("Short Exit", "Short", stop=sl_s, limit=tp_s, comment="TP/SL")

// ============================================================================
// VISUALS — plotshape for signals and sweeps (always scroll with chart)
// ============================================================================

// Entry signals — large arrows
plotshape(lSig, title="Long Signal",  style=shape.triangleup,   location=location.belowbar, color=#26a69a, size=size.small, text="LONG")
plotshape(sSig, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=#ef5350, size=size.small, text="SHORT")

// Manipulation sweep markers — small dots
plotshape(mBull and not mBull[1], title="Sweep Low",  style=shape.circle, location=location.belowbar, color=color.new(#26a69a, 40), size=size.tiny)
plotshape(mBear and not mBear[1], title="Sweep High", style=shape.circle, location=location.abovebar, color=color.new(#ef5350, 40), size=size.tiny)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(lSig,                  title="Long Signal",          message="[Po3+IFVG] LONG — sweep low confirmed, price at FVG/IFVG zone.")
alertcondition(sSig,                  title="Short Signal",         message="[Po3+IFVG] SHORT — sweep high confirmed, price at FVG/IFVG zone.")
alertcondition(mBull and not mBull[1],title="Bullish Sweep",        message="[Po3] SWEEP LOW — bullish manipulation. Watch for FVG/IFVG entry.")
alertcondition(mBear and not mBear[1],title="Bearish Sweep",        message="[Po3] SWEEP HIGH — bearish manipulation. Watch for FVG/IFVG entry.")
